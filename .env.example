# Copy to .env.local and fill in.

# Base URL of the deployed api/server.js (no trailing slash).
# Leave empty to serve videos from the bundled data/videos.json (works on GitHub Pages).
# For local development with `npm run dev`, use http://localhost:3001
VITE_API_URL=

# Server-only: read by api/server.js for the XP AI chat. Never prefix this with VITE_,
# or Vite will bundle it into the public JavaScript.
GEMINI_API_KEY=
